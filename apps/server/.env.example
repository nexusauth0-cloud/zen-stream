# Media proxy configuration (server-side only).
#
# The Express server proxies catalog and playback metadata from the
# configured upstream media API. Set these in your shell or environment
# file before starting the server:
#
#   MEDIA_API_BASE_URL=https://your-upstream-worker.example.com
#   MEDIA_API_SECRET=your-worker-secret
#
# When unset, the server still runs but media endpoints respond with
# 503 MEDIA_NOT_CONFIGURED. Credentials never leave the server.
MEDIA_API_BASE_URL=
MEDIA_API_SECRET=